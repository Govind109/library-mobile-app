{
  "name": "library-student-mobile",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "cross-env EXPO_PUBLIC_API_BASE_URL=http://192.168.31.239:8000/api expo start",
    "start:local": "cross-env EXPO_PUBLIC_API_BASE_URL=http://192.168.31.239:8000/api expo start",
    "start:live": "cross-env EXPO_PUBLIC_API_BASE_URL=https://lib.kypsapp.in/api expo start",
    "android": "cross-env EXPO_PUBLIC_API_BASE_URL=http://192.168.31.239:8000/api expo run:android",
    "android:local": "cross-env EXPO_PUBLIC_API_BASE_URL=http://192.168.31.239:8000/api expo run:android",
    "android:live": "cross-env EXPO_PUBLIC_API_BASE_URL=https://lib.kypsapp.in/api expo run:android",
    "ios": "cross-env EXPO_PUBLIC_API_BASE_URL=http://192.168.31.239:8000/api expo run:ios",
    "ios:local": "cross-env EXPO_PUBLIC_API_BASE_URL=http://192.168.31.239:8000/api expo run:ios",
    "ios:live": "cross-env EXPO_PUBLIC_API_BASE_URL=https://lib.kypsapp.in/api expo run:ios",
    "web": "expo start --web",
    "eas:preview:android": "npx eas-cli build --profile preview --platform android",
    "eas:preview:ios": "npx eas-cli build --profile preview --platform ios",
    "eas:testing:android": "npx eas-cli build --profile testing --platform android",
    "eas:testing:ios": "npx eas-cli build --profile testing --platform ios",
    "eas:production:android": "npx eas-cli build --profile production --platform android",
    "eas:production:ios": "npx eas-cli build --profile production --platform ios",
    "eas:playstore": "npx eas-cli build --profile production --platform android",
    "eas:init": "npx eas-cli init"
  },
  "dependencies": {
