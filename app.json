{
  "expo": {
    "name": "KYPS Library",
    "slug": "library-student",
    "version": "1.0.6",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "mobileapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#002B5B"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.kypsapp.library",
      "infoPlist": {
        "GADApplicationIdentifier": "ca-app-pub-2983364415472853~6916623097",
        "NSUserTrackingUsageDescription": "This identifier is used to deliver ads and keep the app free."
      }
    },
    "android": {
      "package": "com.kypsapp.library",
      "googleServicesFile": "./google-services.json",
      "versionCode": 8,
      "usesCleartextTraffic": true,
      "permissions": [
        "com.google.android.gms.permission.AD_ID",
        "android.permission.POST_NOTIFICATIONS"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#002B5B"
      },
      "edgeToEdgeEnabled": true,
      "softwareKeyboardLayoutMode": "resize",
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "extra": {
      "apiBaseUrl": "http://192.168.31.239:8000/api",
      "firebaseProjectId": "kypsapp-library",
      "apiKey": "AIzaSyAX6T62F6uy1kvaRhBsBZp6jWdho5pSc44",
      "authDomain": "kypsapp-library.firebaseapp.com",
      "projectId": "kypsapp-library",
      "storageBucket": "kypsapp-library.firebasestorage.app",
      "messagingSenderId": "120638727691",
      "appId": "1:120638727691:web:0d8e0ac58675714820c90e",
      "measurementId": "G-B95SW94560",
      "showGoogleAds": true,
      "webClientId": "",
      "androidClientId": "",
      "iosClientId": "",
      "router": {},
      "eas": {
        "projectId": "f40c8647-1e28-4287-8f09-c6e651d2b79f"
      }
    },
    "plugins": [
      "expo-router",
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-2983364415472853~6916623097",
          "iosAppId": "ca-app-pub-2983364415472853~6916623097"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/icon.png",
          "imageWidth": 240,
          "resizeMode": "contain",
          "backgroundColor": "#002B5B"
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#002B5B"
        }
      ],
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "owner": "govind.itarhi"
  }
