{
  "cli": {
    "version": ">= 18.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "http://192.168.31.239:8000/api",
        "EXPO_PUBLIC_SHOW_GOOGLE_ADS": "true"
      }
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "simulator": false
      },
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "http://192.168.31.239:8000/api",
        "EXPO_PUBLIC_SHOW_GOOGLE_ADS": "true"
      }
    },
    "testing": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "simulator": false
      },
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://lib.kypsapp.in/api",
        "EXPO_PUBLIC_SHOW_GOOGLE_ADS": "true"
      }
    },
    "production": {
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://lib.kypsapp.in/api",
        "EXPO_PUBLIC_SHOW_GOOGLE_ADS": "true"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
